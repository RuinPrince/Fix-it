# ============================================
# Fix It — Project Environment Variables
# Copy this to .env and fill in your values
# ============================================

# ===== Database =====
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fixit_db
DB_USER=fixit_user
DB_PASSWORD=fixit_pass_2025
DB_ROOT_PASSWORD=fixitroot2025

# ===== Backend =====
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
JWT_SECRET=fixit-jwt-secret-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=fixit-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ===== Redis =====
REDIS_HOST=localhost
REDIS_PORT=6379

# ===== Firebase (optional) =====
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Place firebase-service-account.json in backend/ root

# ===== File Upload =====
MAX_FILE_SIZE=10485760
MAX_FILES_PER_COMPLAINT=5

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
